// This file was generated from a template. Edit it to match your keyboard.
// See https://zmk.dev/docs/development/hardware-integration/new-shield for more instructions.

#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>

#define BASE   0
#define LOWER  1
#define RAISE  2
#define BOTH   3
#define ADJ    4
#define EX     5
#define DET    6

/ {
    // Define a default keymap here.
    // See https://zmk.dev/docs/development/hardware-integration/new-shield#default-keymap.

    combos {
        compatible = "zmk,combos";

        combo_s {
            bindings = <&kp S>;
            key-positions = <6 7>;
            layers = <0>;
            timeout-ms = <30>;
        };

        combo_h {
            bindings = <&kp H>;
            key-positions = <0 6>;
            layers = <0>;
            timeout-ms = <30>;
        };

        combo_d {
            bindings = <&kp D>;
            key-positions = <1 2>;
            layers = <0>;
            timeout-ms = <30>;
        };

        combo_l {
            bindings = <&kp L>;
            key-positions = <7 8 9>;
            layers = <0>;
            timeout-ms = <30>;
        };

        combo_c {
            bindings = <&kp C>;
            key-positions = <8 9>;
            layers = <0>;
            timeout-ms = <30>;
        };

        combo_u {
            bindings = <&kp U>;
            key-positions = <7 8>;
            layers = <0>;
            timeout-ms = <30>;
        };

        combo_m {
            bindings = <&kp M>;
            key-positions = <9 7>;
            layers = <0>;
            timeout-ms = <30>;
        };

        combo_w {
            bindings = <&kp W>;
            key-positions = <2 0>;
            layers = <0>;
            timeout-ms = <30>;
        };

        combo_f {
            bindings = <&kp F>;
            key-positions = <0 1>;
            layers = <0>;
            timeout-ms = <30>;
        };

        combo_g {
            bindings = <&kp G>;
            key-positions = <1 7>;
            layers = <0>;
            timeout-ms = <30>;
        };

        combo_y {
            bindings = <&kp Y>;
            key-positions = <1 0 9>;
            layers = <0>;
            timeout-ms = <30>;
        };

        combo_p {
            bindings = <&kp P>;
            key-positions = <2 6>;
            layers = <0>;
            timeout-ms = <30>;
        };

        combo_b {
            bindings = <&kp B>;
            key-positions = <6 9>;
            layers = <0>;
            timeout-ms = <30>;
        };

        combo_v {
            bindings = <&kp V>;
            key-positions = <2 7>;
            layers = <0>;
            timeout-ms = <30>;
        };

        combo_k {
            bindings = <&kp K>;
            key-positions = <9 1>;
            layers = <0>;
            timeout-ms = <30>;
        };

        combo_j {
            bindings = <&kp J>;
            key-positions = <0 9>;
            layers = <0>;
            timeout-ms = <30>;
        };

        combo_x {
            bindings = <&kp X>;
            key-positions = <1 0 2>;
            layers = <0>;
            timeout-ms = <30>;
        };

        combo_q {
            bindings = <&kp Q>;
            key-positions = <0 6 1>;
            layers = <0>;
            timeout-ms = <30>;
        };

        combo_z {
            bindings = <&kp Z>;
            key-positions = <7 8 6>;
            layers = <0>;
            timeout-ms = <30>;
        };

        tobt {
            bindings = <&to 6>;
            key-positions = <1 0 7 2 8 9>;
            layers = <0>;
        };

        combo_0 {
            bindings = <&kp N0>;
            key-positions = <1 2 15>;
            layers = <0>;
        };

        combo_1 {
            bindings = <&kp NUMBER_1>;
            key-positions = <7 15>;
            layers = <0>;
        };

        combo_2 {
            bindings = <&kp NUMBER_2>;
            key-positions = <15 8>;
            layers = <0>;
        };

        combo_3 {
            bindings = <&kp NUMBER_3>;
            key-positions = <9 15>;
            layers = <0>;
        };

        combo_4 {
            bindings = <&kp NUMBER_4>;
            key-positions = <0 15>;
            layers = <0>;
        };

        combo_5 {
            bindings = <&kp N5>;
            key-positions = <15 1>;
            layers = <0>;
        };

        combo_6 {
            bindings = <&kp NUMBER_6>;
            key-positions = <2 15>;
            layers = <0>;
        };

        combo_7 {
            bindings = <&kp N7>;
            key-positions = <7 8 15>;
            layers = <0>;
        };

        combo_8 {
            bindings = <&kp N8>;
            key-positions = <9 8 15>;
            layers = <0>;
        };

        combo_9 {
            bindings = <&kp N9>;
            key-positions = <1 0 15>;
            layers = <0>;
        };

        combo_skctrl {
            bindings = <&sk LCTRL>;
            key-positions = <0 7>;
            layers = <0>;
        };

        combo_skalt {
            bindings = <&sk LEFT_ALT>;
            key-positions = <1 8>;
            layers = <0>;
        };

        combo_skgui {
            bindings = <&sk LEFT_GUI>;
            key-positions = <2 9>;
            layers = <0>;
        };

        combo_home {
            bindings = <&kp HOME>;
            key-positions = <0 1>;
            layers = <1>;
        };

        combo_end {
            bindings = <&kp END>;
            key-positions = <1 2>;
            layers = <1>;
        };

        combo_enter {
            bindings = <&kp ENTER>;
            key-positions = <8 9>;
            layers = <1>;
        };

        combo_pgup {
            bindings = <&kp PG_UP>;
            key-positions = <0 1 2>;
            layers = <1>;
        };

        combo_pgdn {
            bindings = <&kp PG_DN>;
            key-positions = <7 8 9>;
            layers = <1>;
        };

        combo_comma {
            bindings = <&kp COMMA>;
            key-positions = <6 7>;
            layers = <1>;
        };

        combo_dot {
            bindings = <&kp DOT>;
            key-positions = <8 7>;
            layers = <1>;
        };

        combo_semi {
            bindings = <&kp SEMI>;
            key-positions = <7 8 6>;
            layers = <1>;
        };

        combo_sqt {
            bindings = <&kp SQT>;
            key-positions = <2 9>;
            layers = <1>;
        };

        combo_excl {
            bindings = <&kp EXCLAMATION>;
            key-positions = <0 7>;
            layers = <1>;
        };

        combo_qmark {
            bindings = <&kp QUESTION>;
            key-positions = <2 9>;
        };

        combo_grave {
            bindings = <&kp GRAVE>;
            key-positions = <0 6>;
            layers = <1>;
        };
    };

    behaviors {
        hl: home_layer {
            compatible = "zmk,behavior-hold-tap";
            label = "HOME_LAYER";
            bindings = <&mo>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <300>;
            quick-tap-ms = <200>;
            flavor = "tap-preferred";
        };
    };

    keymap {
        compatible = "zmk,keymap";

        base {
            bindings = <
&kp I  &kp O  &kp N  &kp N  &kp O  &kp I  &hl 2 T  &hl 3 E  &kp R  &hl 4 A  &kp A  &kp R  &kp E  &kp T  &kp BSPC  &hl 1 SPACE  &kp SPACE  &kp BSPC
            >;
        };

        lower {
            bindings = <
&kp ESCAPE  &kp UP_ARROW  &kp BACKSPACE  &none  &none  &none  &kp TAB  &kp LEFT_ARROW  &kp DOWN_ARROW  &kp RIGHT_ARROW  &none  &none  &none  &none  &none  &none  &none  &none
            >;
        };

        raise {
            bindings = <
&kp LEFT_PARENTHESIS  &kp LBKT  &kp LEFT_BRACE  &none  &none  &none  &none  &kp RIGHT_PARENTHESIS  &kp RBKT  &kp RIGHT_BRACE  &none  &none  &none  &none  &none  &none  &none  &none
            >;
        };

        both {
            bindings = <
&kp UNDERSCORE  &kp PLUS  &kp MINUS  &none  &none  &none  &kp BACKSLASH  &none  &kp ASTERISK  &kp SLASH  &none  &none  &none  &none  &none  &kp EQUAL  &none  &none
            >;
        };

        adj {
            bindings = <
&kp AT_SIGN  &kp POUND  &none  &none  &none  &none  &kp DOLLAR  &kp PERCENT  &kp LCTRL  &none  &none  &none  &none  &none  &none  &kp AMPERSAND  &none  &none
            >;
        };

        ex {
            bindings = <
&none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none
            >;
        };

        det {
            bindings = <
&bt BT_CLR  &studio_unlock  &none  &none  &none  &none  &bt BT_SEL 3  &bt BT_SEL 2  &bt BT_SEL 1  &bt BT_SEL 0  &none  &none  &none  &none  &none  &to 0  &none  &none
            >;
        };
    };

    conditional_layers { compatible = "zmk,conditional-layers"; };
};
